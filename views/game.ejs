<% if (boxFacesReady) { %>
<script>
(function(){
  var box = document.querySelector('.gpbox');
  if (!box) return;
  var rx = -7, ry = -13, dragging = false, lastX = 0, lastY = 0;
  var SENS_Y = 0.5, SENS_X = 0.42;
  function apply() {
    box.style.transform = 'translateZ(0) rotateX(' + rx.toFixed(2) + 'deg) rotateY(' + ry.toFixed(2) + 'deg)';
  }
  function down(e) {
    dragging = true; lastX = e.clientX; lastY = e.clientY;
    box.style.transition = 'none';
    if (e.pointerId != null && box.setPointerCapture) { try { box.setPointerCapture(e.pointerId); } catch (err) {} }
  }
  function move(e) {
    if (!dragging) return;
    var dx = e.clientX - lastX, dy = e.clientY - lastY;
    lastX = e.clientX; lastY = e.clientY;
    ry += dx * SENS_Y;
    rx = Math.max(-40, Math.min(40, rx - dy * SENS_X));
    apply();
  }
  function up() {
    if (!dragging) return;
    dragging = false;
    box.style.transition = 'transform .25s ease-out';
  }
  box.addEventListener('pointerdown', down);
  box.addEventListener('pointermove', move);
  box.addEventListener('pointerup', up);
  box.addEventListener('pointercancel', up);
})();
</script>
<% } %>
<script>
(function(){
  var els=document.querySelectorAll('.rv');
  var io=new IntersectionObserver(function(es){
    es.forEach(function(e){
      if(e.isIntersecting){e.target.classList.add('vis');io.unobserve(e.target);}
    });
  },{threshold:.15,rootMargin:'0px 0px -50px 0px'});
  els.forEach(function(el){io.observe(el);});
  // Fallback: IntersectionObserver callbacks are deprioritized/frozen by the
  // browser while the tab is backgrounded (visibilityState "hidden"), and can
  // also simply fail to fire on some devices/slow loads. A permanently
  // opacity:0 section (title, stats, description all invisible) reads as a
  // broken page, so force everything visible after 1.2s regardless of
  // whether the observer ever ran.
  setTimeout(function(){
    els.forEach(function(el){ el.classList.add('vis'); });
    io.disconnect();
  },1200);
})();
</script>
<script src="/api/public/runtime.js" defer></script>
