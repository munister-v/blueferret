<!doctype html>
<html lang="uk" data-bf-generated-game="true">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width,initial-scale=1,viewport-fit=cover">
<title><%= title %> | Blue Ferret</title>
<meta name="description" content="<%= metaDesc %>">
<link rel="canonical" href="https://blueferret.com.ua/igry/<%= escapeHtml(g.slug) %>/">
<meta property="og:title" content="<%= title %> | Blue Ferret">
<meta property="og:description" content="<%= metaDesc %>">
<meta property="og:url" content="https://blueferret.com.ua/igry/<%= escapeHtml(g.slug) %>/">
<meta property="og:type" content="article">
<meta property="og:image" content="<%= coverAbs %>">
<meta name="twitter:card" content="summary_large_image">
<meta name="twitter:title" content="<%= title %> | Blue Ferret">
<meta name="twitter:image" content="<%= coverAbs %>">
<link rel="shortcut icon" href="/favicon.ico">
<link rel="stylesheet" href="/bf.css?v=37">
<style>
/* Same face the rest of the site uses (the Next.js bundle self-hosts it, but
   this page doesn't load that bundle — so declare it here too). */
@font-face{font-family:Comfortaa;src:url(/fonts/Comfortaa-VariableFont_wght.ttf) format("truetype");font-weight:300 700;font-display:swap}
:root {
  --bg-main: <%= bgColor %>;
  --accent: <%= accentColor %>;
  --text-1: <%= theme.text1 %>;
  --text-2: <%= theme.text2 %>;
  --text-3: <%= theme.text3 %>;
  --text-4: <%= theme.text4 %>;
  --surface-1: <%= theme.surface1 %>;
  --surface-2: <%= theme.surface2 %>;
  --border-1: <%= theme.border1 %>;
  --border-2: <%= theme.border2 %>;
  --hero-scrim: <%= theme.heroScrim %>;
  --section-tint: <%= theme.sectionTint %>;
  --footer-grad: <%= theme.footerGrad %>;
  --shadow-soft: <%= theme.shadowSoft %>;
  --hero-title-shadow: <%= theme.heroTitleShadow %>;
  --hero-sub-shadow: <%= theme.heroSubShadow %>;
  --hero-sub: <%= theme.heroSub %>;
  --hero-scroll-fg: <%= theme.heroScrollFg %>;
  --btn-sec-bg: <%= theme.btnSecBg %>;
  --btn-sec-hover-bg: <%= theme.btnSecHoverBg %>;
  --btn-sec-fg: <%= theme.btnSecFg %>;
  --btn-sec-border: <%= theme.btnSecBorder %>;
  --btn-sec-shadow: <%= theme.btnSecShadow %>;
  --footer-logo-filter: <%= theme.footerLogoFilter %>;
  --header-bg: <%= theme.headerBg %>;
  --header-border: <%= theme.headerBorder %>;
  --header-shadow: <%= theme.headerShadow %>;
  --header-logo: <%= theme.headerLogo %>;
  --header-sub: <%= theme.headerSub %>;
  --header-nav: <%= theme.headerNav %>;
  --header-nav-hover: <%= theme.headerNavHover %>;
  --header-nav-hover-bg: <%= theme.headerNavHoverBg %>;
  --header-active-bg: <%= theme.headerActiveBg %>;
}
*{box-sizing:border-box;margin:0;padding:0}
html{scroll-behavior:smooth}
body{font-family:'Comfortaa',system-ui,sans-serif;background:var(--bg-main);color:var(--text-1);-webkit-font-smoothing:antialiased;overflow-x:hidden}
/* ── HEADER ── */
.gp-header{height:64px;display:flex;align-items:center;justify-content:space-between;padding:0 24px;position:sticky;top:0;z-index:100;background:var(--header-bg);border-bottom:1px solid var(--header-border);box-shadow:var(--header-shadow);backdrop-filter:blur(14px)}
.gp-logo{display:flex;align-items:center;gap:12px;text-decoration:none}
.gp-logo img{width:40px;height:40px;object-fit:contain}
.gp-logo-name{font-weight:700;font-size:15px;color:var(--header-logo);letter-spacing:-.01em}
.gp-logo-sub{font-size:10px;text-transform:uppercase;letter-spacing:.18em;color:var(--header-sub)}
.gp-nav{display:flex;align-items:center;gap:4px}
.gp-nav a{color:var(--header-nav);text-decoration:none;font-weight:500;font-size:14px;padding:8px 14px;border-radius:10px;transition:color .2s,background .2s}
.gp-nav a:hover{color:var(--header-nav-hover);background:var(--header-nav-hover-bg)}
.gp-nav a.active{color:var(--header-nav-hover);font-weight:700;background:var(--header-active-bg)}
.gp-kik-wrap{display:flex;align-items:center;margin-left:12px;padding-left:12px;border-left:1px solid var(--header-border)}
.gp-kik{display:flex;align-items:center;justify-content:center;padding:6px 10px;border-radius:10px;border:1px solid var(--header-border);transition:border-color .2s,background .2s}
.gp-kik:hover{border-color:#6EE7B7;background:rgba(110,231,183,.12)}
.gp-kik img{height:26px;width:auto;object-fit:contain;display:block}
/* Phones: the nav used to be display:none with no replacement, leaving the
   logo as the only way off the page. Three links fit if the wordmark goes. */
@media(max-width:768px){.gp-header{padding:0 12px}.gp-logo>div{display:none}.gp-nav{gap:2px}.gp-nav a{font-size:13px;padding:8px 10px;white-space:nowrap}.gp-kik-wrap{display:none}}
@media(max-width:340px){.gp-nav a{font-size:12px;padding:8px 7px}}
/* ── HERO ── */
.gp-hero{position:relative;min-height:100vh;display:flex;flex-direction:column;align-items:center;justify-content:center;overflow:hidden}
.gp-hero-bg{position:absolute;inset:0}
.gp-hero-bg img, .gp-hero-bg video{width:100%;height:100%;object-fit:cover;object-position:center top}
.gp-hero-overlay{position:absolute;inset:0;background:linear-gradient(180deg,var(--bg-main) 0%, transparent 46%, var(--bg-main) 100%), var(--hero-scrim)}
<% if (theme.isLight) { %>.gp-hero-overlay{background:none}<% } %>
.gp-hero-body{position:relative;z-index:10;text-align:center;padding:40px 24px;max-width:820px;display:flex;flex-direction:column;align-items:center}
.gp-kicker{display:inline-flex;align-items:center;gap:8px;background:var(--surface-1);border:1px solid var(--border-2);border-radius:99px;padding:8px 20px;font-size:11px;font-weight:800;text-transform:uppercase;letter-spacing:.15em;color:var(--accent);margin-bottom:24px;backdrop-filter:blur(10px)}
.gp-hero-logo{width:88vw;max-width:600px;height:auto;filter:drop-shadow(0 20px 40px var(--shadow-soft));animation:float 6s ease-in-out infinite}
@keyframes float { 0%,100%{transform:translateY(0)} 50%{transform:translateY(-15px)} }
.gp-hero-title{font-size:clamp(52px,10vw,110px);font-weight:700;line-height:.88;letter-spacing:-.04em;color:var(--text-1);text-shadow:var(--hero-title-shadow);margin-bottom:18px}
.gp-hero-sub{font-size:clamp(16px,2.5vw,21px);font-weight:500;color:var(--hero-sub);max-width:560px;margin:24px auto 32px;line-height:1.5;text-shadow:var(--hero-sub-shadow)}
.gp-hero-scroll{position:absolute;bottom:40px;left:50%;transform:translateX(-50%);display:flex;flex-direction:column;align-items:center;gap:8px;color:var(--hero-scroll-fg);text-shadow:var(--hero-sub-shadow);font-size:10px;font-weight:700;letter-spacing:.2em;text-transform:uppercase;cursor:pointer}
.gp-hero-scroll svg{width:24px;height:24px;animation:gpBounce 2.2s ease-in-out infinite}
@keyframes gpBounce{0%,100%{transform:translateY(0)}50%{transform:translateY(8px)}}
/* ── BUTTONS ── */
.gp-btn-p{display:inline-flex;align-items:center;justify-content:center;height:52px;padding:0 28px;border-radius:14px;background:var(--accent);color:#fff;font-weight:700;font-size:15px;text-decoration:none;box-shadow:0 10px 28px -10px var(--accent);transition:all .2s;text-transform:uppercase;letter-spacing:.05em}
.gp-btn-p:hover{filter:brightness(1.1);transform:translateY(-2px);box-shadow:0 16px 36px -10px var(--accent)}
.gp-btn-s{display:inline-flex;align-items:center;justify-content:center;height:52px;padding:0 24px;border-radius:14px;background:var(--btn-sec-bg);color:var(--btn-sec-fg);font-weight:600;font-size:15px;text-decoration:none;border:1px solid var(--btn-sec-border);box-shadow:var(--btn-sec-shadow);transition:all .2s}
.gp-btn-s:hover{background:var(--btn-sec-hover-bg);color:var(--text-1);border-color:var(--accent);transform:translateY(-1px)}
.gp-actions{display:flex;flex-wrap:wrap;gap:12px;margin-top:28px}
/* ── SECTIONS ── */
.gp-section{padding:80px 24px;position:relative}
.gp-inner{max-width:1024px;margin:0 auto}
.gp-eyebrow{font-size:12px;font-weight:600;letter-spacing:.25em;text-transform:uppercase;color:var(--text-4);margin-bottom:16px}
.gp-stitle{font-size:clamp(30px,4vw,48px);font-weight:700;color:var(--text-1);margin-bottom:16px;letter-spacing:-.02em}
/* ── PASSPORT ── */
.pp-layout{display:grid;grid-template-columns:1.15fr 1fr;gap:16px;align-items:start;margin-bottom:32px}
.pp-layout.pp-solo{grid-template-columns:1fr}
.pp-grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(148px,1fr));gap:16px}
.pp-status{background:var(--surface-1);border:1px solid var(--border-1);border-radius:16px;padding:28px}
.pp-status-eyebrow{font-size:11px;font-weight:600;letter-spacing:.2em;text-transform:uppercase;color:var(--text-4);margin-bottom:12px}
.pp-status-title{font-size:24px;font-weight:700;color:var(--text-1);margin-bottom:20px;letter-spacing:-.01em}
.pp-bar{height:8px;border-radius:99px;overflow:hidden;background:var(--surface-2);margin-bottom:10px}
.pp-bar-fill{height:100%;border-radius:99px;background:var(--accent)}
.pp-bar-meta{display:flex;justify-content:space-between;gap:8px;font-size:12px;color:var(--text-3)}
.pp-card{background:var(--surface-1);border:1px solid var(--border-1);border-radius:16px;padding:24px;transition:all .3s ease}
.pp-card:hover{background:var(--surface-2);transform:translateY(-4px);border-color:var(--accent)}
.pp-ico{margin-bottom:12px;color:var(--accent);opacity:.8}
.pp-ico svg{width:20px;height:20px}
.pp-label{font-size:11px;font-weight:600;letter-spacing:.15em;text-transform:uppercase;color:var(--text-4);margin-bottom:6px}
.pp-val{font-size:16px;font-weight:600;color:var(--text-1)}
/* ── ABOUT GRID ── */
.gp-about-grid{display:grid;grid-template-columns:1.05fr 1.1fr;gap:40px;align-items:center;margin-top:40px}
.gp-about-visual{--gpbox-box:300px;--gpbox-depth:calc(var(--gpbox-box) * 0.2564);background:radial-gradient(circle at 50% 20%, var(--surface-1) 0%, transparent 60%), var(--section-tint);border:1px solid var(--border-1);border-radius:24px;padding:40px;display:flex;flex-direction:column;align-items:center;justify-content:center;gap:16px;min-height:420px;perspective:2100px}
.gp-3d-box{width:280px;border-radius:12px;box-shadow:0 30px 60px -20px var(--shadow-soft), 0 0 0 1px var(--border-2);transition:transform 0.4s cubic-bezier(0.2,0.8,0.2,1);transform:rotateY(-10deg) rotateX(5deg)}
.gp-about-visual:hover .gp-3d-box{transform:rotateY(0deg) rotateX(0deg) scale(1.05)}
.gp-3d-box img{width:100%;height:auto;border-radius:12px;display:block}
/* ── Real 3D box (6 uploaded faces) — used instead of .gp-3d-box when a game
   has all six box_faces set. Drag-to-rotate, own local script below, no
   dependency on bf.js (draft game pages don't load it). ── */
.gp-box-hint{display:flex;align-items:center;justify-content:center;gap:8px;margin:0 0 16px;font-size:14px;color:var(--text-3);text-align:center}.gp-box-hint svg{width:16px;height:16px;flex:none;opacity:.7}
.gpbox{margin:0 auto;cursor:grab}
.gpbox:active{cursor:grabbing}
.gpbox img{width:100%;height:100%;object-fit:cover;display:block;-webkit-user-drag:none;user-select:none}
.gpbox-face{position:absolute;left:50%;top:50%;backface-visibility:hidden;border-radius:3px;overflow:hidden;box-shadow:0 0 24px -10px rgba(0,0,0,.5) inset}
.gpbox-face-front,.gpbox-face-back{width:var(--gpbox-box);height:var(--gpbox-box);margin-left:calc(var(--gpbox-box) / -2);margin-top:calc(var(--gpbox-box) / -2)}
.gpbox-face-front{transform:translateZ(calc(var(--gpbox-depth) / 2))}
.gpbox-face-back{transform:rotateY(180deg) translateZ(calc(var(--gpbox-depth) / 2))}
.gpbox-face-right,.gpbox-face-left{width:var(--gpbox-depth);height:var(--gpbox-box);margin-left:calc(var(--gpbox-depth) / -2);margin-top:calc(var(--gpbox-box) / -2)}
.gpbox-face-right{transform:rotateY(90deg) translateZ(calc(var(--gpbox-box) / 2))}
.gpbox-face-left{transform:rotateY(-90deg) translateZ(calc(var(--gpbox-box) / 2))}
.gpbox-face-top,.gpbox-face-bottom{width:var(--gpbox-box);height:var(--gpbox-depth);margin-left:calc(var(--gpbox-box) / -2);margin-top:calc(var(--gpbox-depth) / -2)}
.gpbox-face-top{transform:rotateX(90deg) translateZ(calc(var(--gpbox-box) / 2))}
.gpbox-face-bottom{transform:rotateX(-90deg) translateZ(calc(var(--gpbox-box) / 2))}
.gp-about-content{background:linear-gradient(180deg, var(--surface-1) 0%, transparent 100%);border:1px solid var(--border-1);border-radius:24px;padding:40px;box-shadow:0 22px 50px -20px var(--shadow-soft)}
.gp-desc{font-size:16px;line-height:1.7;color:var(--text-2)}
.gp-desc p{margin-bottom:16px}
.gp-desc p:last-child{margin-bottom:0}
/* ── FOOTER (same structure as the rest of the site; white on light theme) ── */
.gp-footer{position:relative;overflow:hidden;background:<%= theme.isLight ? '#ffffff' : 'var(--footer-grad)' %>;border-top:1px solid var(--border-1)}
.gp-footer::before{content:'';display:block;height:3px;background:linear-gradient(90deg,transparent,rgba(0,159,227,.8) 25%,rgba(75,178,114,.7) 50%,rgba(245,165,36,.6) 75%,transparent)}
.gp-ft{max-width:1152px;margin:0 auto;padding:88px 32px 40px}
.gp-ft-grid{display:grid;grid-template-columns:5fr 4fr 3fr;gap:56px}
.gp-ft-logo{display:inline-flex;align-items:center;justify-content:center;width:44px;height:44px;margin-bottom:24px;transition:transform .3s}
.gp-ft-logo:hover{transform:scale(1.05)}
.gp-ft-logo img{width:32px;height:32px;object-fit:contain}
.gp-ft-brand h3{font-weight:700;font-size:24px;letter-spacing:-.01em;color:var(--text-1);margin-bottom:16px}
.gp-ft-brand p{color:var(--text-3);font-size:15px;line-height:1.7;max-width:384px}
.gp-ft h4{font-weight:700;font-size:12px;text-transform:uppercase;letter-spacing:.2em;color:var(--text-3);margin-bottom:24px}
.gp-ft-nav{list-style:none;display:flex;flex-direction:column;gap:16px}
.gp-ft-nav a,.gp-ft-mail{display:inline-flex;align-items:center;gap:10px;color:var(--text-2);text-decoration:none;font-size:15px;transition:color .3s}
.gp-ft-nav a:hover,.gp-ft-mail:hover{color:#009fe3}
.gp-ft-nav a:hover .gp-ft-dot{background:#009fe3;transform:scale(1.25)}
.gp-ft-dot{width:6px;height:6px;border-radius:99px;background:var(--text-4);transition:all .3s;flex:none}
.gp-ft-nav svg{width:16px;height:16px;opacity:.5;transition:all .3s;flex:none}
.gp-ft-nav a:hover svg{opacity:1;transform:scale(1.1)}
.gp-ft-mail{margin-bottom:24px;word-break:break-all}
.gp-ft-mail svg{width:16px;height:16px;flex:none}
.gp-ft-social{display:flex;gap:12px}
.gp-ft-social a{display:inline-flex;padding:14px;border-radius:12px;background:var(--surface-2);border:1px solid var(--border-1);color:var(--text-2);transition:all .3s}
.gp-ft-social a:hover{transform:scale(1.1);color:#fff;border-color:transparent}
.gp-ft-social a.ig:hover{background:#009fe3;box-shadow:0 0 25px -5px rgba(0,159,227,.5)}
.gp-ft-social a.fb:hover{background:#4bb272;box-shadow:0 0 25px -5px rgba(75,178,114,.5)}
.gp-ft-social a.tg:hover{background:#14b8a6;box-shadow:0 0 25px -5px rgba(20,184,166,.5)}
.gp-ft-social svg{width:20px;height:20px}
.gp-ft-bottom{margin-top:80px;padding-top:40px;border-top:1px solid var(--border-1)}
.gp-ft-bottom p{font-size:14px;color:var(--text-4)}
@media(max-width:768px){.gp-ft{padding:80px 20px 36px}.gp-ft-grid{grid-template-columns:1fr;gap:48px}.gp-ft-bottom{margin-top:56px;padding-top:32px}}
/* ── RESPONSIVE ── */
@media(max-width:768px){
  .gp-about-grid{grid-template-columns:1fr;gap:24px}
  .gp-about-visual{min-height:300px;padding:20px;--gpbox-box:210px}
  .gp-3d-box{width:220px}
  .gp-about-content{padding:24px}
  .pp-layout{grid-template-columns:1fr}
  .pp-grid{grid-template-columns:repeat(2,1fr)}
  .pp-status{padding:22px}
}
/* ── SCROLL REVEAL ── */
.rv{opacity:0;transform:translateY(30px);transition:all .8s cubic-bezier(0.2,0.8,0.2,1)}
.rv.vis{opacity:1;transform:none}
</style>
</head>
<body>
<div data-bf-generated-game="true">

<header class="gp-header">
  <a class="gp-logo" href="/">
    <img src="/logo-blue-ferret.png" alt="Blue Ferret">
    <div>
      <div class="gp-logo-name">BLUE FERRET</div>
      <div class="gp-logo-sub">видавництво</div>
    </div>
  </a>
  <nav class="gp-nav">
    <a href="/">Головна</a>
    <a href="/igry/" class="active">Наші ігри</a>
    <a href="/kontakty/">Контакти</a>
    <div class="gp-kik-wrap">
      <a class="gp-kik" href="/kik/">
        <img src="/images/kik/logo-kik-horizontal.png" alt="KIK вдома">
      </a>
    </div>
  </nav>
</header>

<main>

<section class="gp-hero">
  <div class="gp-hero-bg">
    <% if (isVideoBg) { %>
      <video autoPlay loop muted playsInline preload="metadata" poster="<%= coverAbs %>"><source src="<%= heroBg %>" type="video/webm"><source src="<%= heroBg %>" type="video/mp4"></video>
    <% } else { %>
      <img src="<%= heroBg %>" alt="<%= title %>" loading="eager">
    <% } %>
  </div>
  <div class="gp-hero-overlay"></div>
  
  <div class="gp-hero-body">
    <% if (heroLogo) { %>
      <img class="gp-hero-logo" src="<%= heroLogo %>" alt="<%= title %>">
    <% } else { %>
      <div class="gp-kicker"><%= statusLabel %></div><h1 class="gp-hero-title" data-bf-id="bf_g_title"><%= title %></h1>
    <% } %>
    <p class="gp-hero-sub" data-bf-id="bf_g_subtitle"><%= subtitle %></p>
    <% if (buy) { %>
      <a class="gp-btn-p" href="<%= buy %>">Придбати →</a>
    <% } else { %>
      <a class="gp-btn-s" href="#passport">Дізнатися більше ↓</a>
    <% } %>
  </div>

  <div class="gp-hero-scroll" onclick="document.getElementById('passport').scrollIntoView({behavior:'smooth'})">
    <span>Зануритися</span>
    <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m6 9 6 6 6-6"/></svg>
  </div>
</section>

<section class="gp-section" id="passport" style="background:var(--section-tint)">
  <div class="gp-inner">
    <div class="rv text-center" style="text-align:center;margin-bottom:40px">
      <p class="gp-eyebrow">Про гру</p>
      <h2 class="gp-stitle">Паспорт пригоди</h2>
      <p style="color:var(--text-3);max-width:600px;margin:0 auto">Коротко про формат гри, щоб одразу зрозуміти, чого чекати.</p>
    </div>
    
    <div class="pp-layout rv<%= (passportCards && stageProgress.total) ? '' : ' pp-solo' %>">
      <% if (passportCards) { %><div class="pp-grid"><%- passportCards %></div><% } %>
      <% if (stageProgress.total) { %>
      <div class="pp-status">
        <p class="pp-status-eyebrow">Стан проєкту</p>
        <h3 class="pp-status-title"><%= stageProgress.currentTitle %></h3>
        <div class="pp-bar"><div class="pp-bar-fill" style="width:<%= stageProgress.pct %>%"></div></div>
        <div class="pp-bar-meta">
          <span><%= stageProgress.pct %>% готовності</span>
          <span><%= stageProgress.open %>/<%= stageProgress.total %> етапи відкрито</span>
        </div>
      </div>
      <% } %>
    </div>
  </div>
</section>

<section class="gp-section" id="about">
  <div class="gp-inner">
    <div class="gp-about-grid">
      <div class="gp-about-visual rv">
        <% if (boxFacesReady) { %>
        <p class="gp-box-hint"><svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 12a9 9 0 1 1-3-6.7"/><path d="M21 3v6h-6"/></svg>Покрути коробочку, не соромся!</p>
        <div class="gpbox" style="width:var(--gpbox-box);height:var(--gpbox-box);position:relative;transform-style:preserve-3d;transform:translateZ(0) rotateX(-7deg) rotateY(-13deg);transition:transform .08s ease-out;will-change:transform;touch-action:none">
          <div class="gpbox-face gpbox-face-front"><img src="<%= boxFaces.front %>" alt="<%= title %> — лицьова сторона коробки" draggable="false" loading="eager"></div>
          <div class="gpbox-face gpbox-face-back"><img src="<%= boxFaces.back %>" alt="<%= title %> — зворотна сторона коробки" draggable="false" loading="lazy"></div>
          <div class="gpbox-face gpbox-face-right"><img src="<%= boxFaces.right %>" alt="" draggable="false" loading="lazy"></div>
          <div class="gpbox-face gpbox-face-left"><img src="<%= boxFaces.left %>" alt="" draggable="false" loading="lazy"></div>
          <div class="gpbox-face gpbox-face-top"><img src="<%= boxFaces.top %>" alt="" draggable="false" loading="lazy"></div>
          <div class="gpbox-face gpbox-face-bottom"><img src="<%= boxFaces.bottom %>" alt="" draggable="false" loading="lazy"></div>
        </div>
        <% } else { %>
        <div class="gp-3d-box">
